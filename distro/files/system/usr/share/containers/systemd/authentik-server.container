# Authentik web/API server. Provides SSO (OIDC) for the dashboard app and
# anything else wired up to it later.

[Unit]
Description=Authentik server
After=postgres.service redis.service
Requires=postgres.service redis.service

[Container]
Image=ghcr.io/goauthentik/server:2025.8
ContainerName=authentik-server
Exec=server
Network=homelab.network
PublishPort=9000:9000
PublishPort=9443:9443
EnvironmentFile=/var/mnt/tank/appdata/secrets/authentik.env
# :U tells Podman to chown the host directory to match the container's
# runtime user (UID 1000 in this image) on start — without it, Authentik
# crash-loops with "PermissionError: [Errno 13] Permission denied:
# '/media/public'" against a freshly-created, root-owned host directory.
# Confirmed against a real run: the LinuxServer *arr images don't need this
# (their own entrypoint self-corrects ownership via PUID/PGID), but
# Authentik's image has no such init step.
Volume=/var/mnt/tank/appdata/authentik/media:/media:U
Volume=/var/mnt/tank/appdata/authentik/certs:/certs:U
Volume=/etc/authentik/blueprints:/blueprints/custom:ro

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

# The custom SSO dashboard app, built separately from apps/homepage-dashboard/
# and published to ghcr.io/<user>/homepage-dashboard. Update <user> below
# before building.

[Unit]
Description=Homepage dashboard
After=authentik-server.service sonarr.service radarr.service prowlarr.service

[Container]
Image=ghcr.io/<user>/homepage-dashboard:latest
ContainerName=homepage-dashboard
Network=homelab.network
PublishPort=3000:3000
EnvironmentFile=/var/mnt/tank/appdata/secrets/dashboard.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

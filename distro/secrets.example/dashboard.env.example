# Copy this file to /var/mnt/tank/appdata/secrets/dashboard.env on the
# installed system and fill in real values. Never commit the real file.
#
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32

# Browser-facing address of the dashboard itself — NOT the internal
# container name. Use this box's actual LAN IP or hostname.
NEXTAUTH_URL=http://<server-lan-ip-or-hostname>:3000
NEXTAUTH_SECRET=

# Container-reachable — used for discovery + token/userinfo/jwks (all
# server-to-server calls the dashboard's backend makes directly).
AUTHENTIK_ISSUER=http://authentik-server:9000/application/o/homepage-dashboard/
# Browser-reachable base origin (same LAN IP/hostname as NEXTAUTH_URL, just
# pointed at Authentik's port instead). Verified against a live Authentik
# instance: its discovery document mirrors whatever host it's requested on
# for EVERY endpoint, so there's no single URL that works for both the
# browser's authorization redirect and the backend's token/userinfo/jwks
# calls — see auth.ts for how this is used.
AUTHENTIK_PUBLIC_URL=http://<server-lan-ip-or-hostname>:9000
AUTHENTIK_CLIENT_ID=homepage-dashboard
# Must match AUTHENTIK_HOMEPAGE_CLIENT_SECRET in authentik.env.example
AUTHENTIK_CLIENT_SECRET=

# In-cluster container DNS names — no change needed unless a Quadlet's
# ContainerName is changed.
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# *arr API keys are generated per-instance the first time each app starts
# (Settings > General > Security > API Key) — there's nothing to pre-bake
# here, fill these in after first boot.

DISK_MOUNT_PATH=/var/mnt/tank

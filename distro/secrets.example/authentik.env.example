# Copy this file to /var/mnt/tank/appdata/secrets/authentik.env on the
# installed system and fill in real values. Never commit the real file.
#
# Generate secrets with: openssl rand -base64 36

# --- Postgres (read by both postgres.container and authentik-*.container) ---
POSTGRES_USER=authentik
POSTGRES_PASSWORD=
POSTGRES_DB=authentik
AUTHENTIK_POSTGRESQL__HOST=postgres
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=

# --- Redis ---
AUTHENTIK_REDIS__HOST=redis

# --- Authentik core ---
AUTHENTIK_SECRET_KEY=
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# --- Used by blueprints/homepage-oidc.yaml to set the dashboard app's OIDC
# client secret. Copy this same value into dashboard.env.example as
# AUTHENTIK_CLIENT_SECRET. ---
AUTHENTIK_HOMEPAGE_CLIENT_SECRET=

# Local dev defaults. For the real deployment inside the homelab-os image,
# the equivalent values live in distro/secrets.example/dashboard.env.example
# and get filled in on the target machine instead of here.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# If Authentik and this app run in different containers/networks, ISSUER
# and PUBLIC_URL will differ — see auth.ts for why. For plain local dev with
# both on localhost, they're usually the same host.
AUTHENTIK_ISSUER=https://authentik.example.com/application/o/homepage-dashboard/
AUTHENTIK_PUBLIC_URL=https://authentik.example.com
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

SONARR_URL=http://localhost:8989
SONARR_API_KEY=
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

DISK_MOUNT_PATH=/

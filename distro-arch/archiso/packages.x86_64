# Base system
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
amd-ucode
intel-ucode
sudo
nano
vim
networkmanager
openssh
reflector

# Partitioning / filesystem tools Calamares' partition/fstab/unpackfs modules need
arch-install-scripts
parted
gptfdisk
dosfstools
e2fsprogs
btrfs-progs
squashfs-tools
rsync
syslinux

# ZFS for the data pool (AUR, via the local repo — see pacman.conf)
zfs-dkms
zfs-utils
linux-headers

# Limine bootloader (installed onto the TARGET system by Calamares, not
# used for the live medium's own boot — see archiso/airootfs/etc/calamares).
# NOTE: deliberately NOT installing limine-mkinitcpio-hook — its pacman hook
# auto-deploys Limine to a FAT32 ESP on every kernel/initramfs update, which
# breaks the archiso build (no real ESP exists inside the build chroot) and
# is redundant with our own homelab-limine-install.sh anyway.
limine
limine-entry-tool

# KDE Plasma desktop
plasma-desktop
sddm
konsole
dolphin
plasma-nm
ark
print-manager

# Calamares installer (AUR, via the local repo). polkit provides pkexec,
# which the installer's desktop launcher uses to gain root.
calamares
polkit

# Podman, for the Quadlets that make up the actual homelab-os stack
podman

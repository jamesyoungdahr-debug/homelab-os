// Live/install medium only: let liveuser launch the installer with no
// password prompt. This ISO's liveuser account (and its password) exist
// only for the duration of the live session — there is no real security
// boundary to protect here, and requiring a password just adds friction
// (and, historically, an unreliable VNC/synthetic-input typing step during
// testing).
//
// Root cause of two earlier failed attempts (both matching
// action.id == "org.freedesktop.policykit.exec", first narrowed by
// action.lookup("program") == "/usr/bin/calamares", then broadened to any
// wheel-group pkexec): confirmed via `journalctl -u polkit` on a real test
// boot — pkexec-launching-calamares actually requests a DIFFERENT,
// Calamares-specific action id, io.calamares.calamares.pkexec.run (its own
// installed polkit .policy file), not the generic pkexec exec action. The
// generic action.id check could never match, no matter how the rest of the
// condition was written. Match the real action id instead.
polkit.addRule(function(action, subject) {
    if (action.id == "io.calamares.calamares.pkexec.run" &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
